# Clusters
CLUSTERS="dr-lab-source dr-lab-restore"
KIND_CLUSTER_CONFIG=manifests/kind-cluster-config.yaml

# App
APP_NAMESPACE=mongodb
EXPECTED_DOCS=1000

# AWS — for Terraform & CLI (SSO)
AWS_PROFILE=k8s-dr-eu
AWS_REGION=eu-west-1

# AWS — for Kasten K10 inside the clusters (static IAM user)
# Leave blank in .env.example; fill in .env with real keys.
K10_AWS_ACCESS_KEY_ID=
K10_AWS_SECRET_ACCESS_KEY=

# Kasten
K10_VERSION=9.0.3
MIN_SIZE_BYTES=1024